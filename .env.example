# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
ADMIN_EMAIL=

# Prijsbeheeromgeving (online prijstool, apart Vercel-project)
# PRIJSTOOL_API_URL: het adres van de prijstool, zonder /admin of /api erachter.
#   Bijvoorbeeld: https://huisnummerbordjes-prijsbeheer-web.vercel.app
# PRIJSTOOL_API_KEY: dezelfde waarde als de API_KEY die in het Vercel-project
#   van de prijstool zelf staat (Project Settings -> Environment Variables).
#   Terug te vinden in het originele .env-bestand van de lokale prijstool
#   (C:\Mijn Docs\Christiaan\huisnummerbordjes-prijsbeheer\.env), achter
#   "API_KEY=".
# Ontbreken deze twee, dan gebruikt de webshop automatisch de vaste
# reservekopie-prijzen uit config/product-options.ts (geen storing).
PRIJSTOOL_API_URL=
PRIJSTOOL_API_KEY=

# MySQL (TiDB Cloud) — hier wordt elke bevestigde bestelling in bewaard,
# als aanvulling op de e-mail die je al krijgt.
# Te vinden in TiDB Cloud: open je cluster -> knop "Connect" -> kies
# "Node.js" als voorbeeld. TIDB_PORT is vrijwel altijd 4000.
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=

# Mollie (betalen), toegevoegd 29-8-2026.
# MOLLIE_API_KEY: te vinden op mollie.com, ingelogd, onder
#   Developers -> API-sleutels. Er zijn twee sleutels: een testsleutel
#   (begint met "test_") om zonder echt geld te betalen te kunnen
#   uitproberen, en een livesleutel (begint met "live_") voor als het echt
#   moet werken. Zet hier eerst de testsleutel neer om alles te
#   controleren, en vervang 'm pas door de livesleutel als alles goed werkt
#   en het Mollie-account volledig geverifieerd is (KVK-nummer,
#   bankrekening voor de uitbetalingen).
# SITE_URL: het volledige, publieke adres waarop de webshop bereikbaar is
#   (zonder slash erachter), bijvoorbeeld https://huisnummerbordje.vercel.app
#   of straks de eigen domeinnaam. Nodig zodat Mollie weet naar welke pagina
#   een klant na het betalen teruggestuurd moet worden, en naar welk adres
#   Mollie een berichtje mag sturen zodra een betaling gelukt/mislukt is.
#   Moet een "echt", vanaf internet bereikbaar adres zijn — "localhost"
#   werkt hier dus niet.
MOLLIE_API_KEY=
SITE_URL=
